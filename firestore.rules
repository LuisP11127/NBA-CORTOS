rules_version = '2';
// Acceso libre: cualquier visitante (con la sesión anónima que abre la app)
// puede leer y escribir. Pegar en Firebase Console > Firestore > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
